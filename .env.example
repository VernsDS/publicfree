# Salin file ini menjadi .env untuk testing lokal, lalu isi valuenya.
# Di Vercel: Project -> Settings -> Environment Variables (isi nama yang sama persis).

MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/publicfree
CF_API_TOKEN=cloudflare_api_token_with_zone_dns_edit
CF_ZONE_PUBLICFREE=cloudflare_zone_id_publicfree_web_id
TURNSTILE_SECRET_KEY=turnstile_secret_key

# Opsional
# PUBLIC_DOMAIN=publicfree.web.id
# MAX_SUBDOMAINS_PER_IP=2
